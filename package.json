{
  "name": "@lookui/core",
  "version": "0.1.0",
  "description": "A no-frills JavaScript & CSS library for UI components. Imperative, predictable, and MVC-friendly.",
  "author": {
    "name": "Bambang Yudhotomo",
    "url": "https://github.com/bambangy"
  },
  "homepage": "https://github.com/bambangy/LookUI",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bambangy/LookUI.git"
  },
  "bugs": {
    "url": "https://github.com/bambangy/LookUI/issues"
  },
  "main": "dist/look.cjs",
  "module": "dist/look.esm.js",
  "style": "dist/look.css",
  "unpkg": "dist/look.min.js",
  "jsdelivr": "dist/look.min.js",
  "exports": {
    ".": {
      "import": "./dist/look.esm.js",
      "require": "./dist/look.cjs",
      "default": "./dist/look.esm.js"
    },
    "./look.css": "./dist/look.css",
    "./look.min.css": "./dist/look.min.css",
    "./dist/*": "./dist/*",
    "./package.json": "./package.json"
  },
  "sideEffects": [
    "*.css"
  ],
  "files": [
    "dist",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "build:js": "rollup -c rollup.config.js",
    "build:css": "sass src/scss/main.scss dist/look.raw.css --no-source-map && postcss dist/look.raw.css --config .postcssrc.cjs --no-map -o dist/look.css && rimraf dist/look.raw.css && node scripts/minify-css.js",
    "build": "npm run build:js && npm run build:css",
    "dev": "rollup -c rollup.config.js --watch",
    "test:smoke": "node scripts/smoke-test.js",
    "prepublishOnly": "npm run build && npm run test:smoke"
  },
  "keywords": [
    "ui",
    "components",
    "vanilla",
    "css",
    "library"
  ],
  "type": "module",
  "license": "MIT",
  "devDependencies": {
    "@rollup/plugin-node-resolve": "^16.0.0",
    "@rollup/plugin-terser": "^1.0.0",
    "autoprefixer": "^10.6.1",
    "cssnano": "^9.1.2",
    "postcss": "^8.5.0",
    "postcss-cli": "^12.0.0",
    "rimraf": "^6.1.3",
    "rollup": "^4.63.6",
    "sass": "^1.105.1"
  },
  "publishConfig": {
    "access": "public"
  }
}
